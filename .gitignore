# Generated registry snapshots. Both files are regenerated by the root
# `postinstall` script (and again by the CLI's `prepack` and the website's
# `vercel-build` hooks). No JSON is committed — `tools/build-snapshots.ts`
# is the single source of truth.
packages/cli/src/registry/snapshot.ts
apps/website/lib/registry-data.ts

