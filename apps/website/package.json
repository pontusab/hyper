{
  "name": "@hyper/website",
  "version": "0.0.0",
  "private": true,
  "description": "hyperjs.ai marketing site — Next.js App Router, Tailwind v4, Shiki for code highlighting.",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "vercel-build": "cd ../.. && bun run ./tools/build-snapshots.ts && cd apps/website && next build"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@types/bun": "1.3.1",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3"
  }
}
