{
  "name": "@hyper/app-registry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "hyperjs.ai — registry service. Manifests built on demand and served via Vercel CDN cache.",
  "scripts": {
    "dev": "bun --hot src/dev.ts",
    "start": "bun src/dev.ts",
    "test": "bun test",
    "typecheck": "tsgo --noEmit || bunx tsc --noEmit -p tsconfig.json",
    "vercel-build": "cd ../.. && bun run ./tools/build-snapshots.ts"
  },
  "dependencies": {
    "@hyper/core": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.3.1"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
