{
  "name": "@usehyper/cli",
  "version": "0.1.1",
  "type": "module",
  "description": "Hyper CLI — registry-driven scaffolding (init/add/diff/update) plus dev/build/test/openapi/mcp.",
  "license": "MIT",
  "homepage": "https://hyperjs.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pontusab/hyper.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/pontusab/hyper/issues"
  },
  "files": ["src", "registry-sources", "LICENSE", "README.md"],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsgo --noEmit || bunx tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "prepack": "bun run ../../tools/build-snapshots.ts"
  },
  "devDependencies": {
    "@hyper/client": "workspace:*",
    "@hyper/core": "workspace:*",
    "@hyper/mcp": "workspace:*",
    "@hyper/openapi": "workspace:*",
    "@hyper/testing": "workspace:*",
    "@types/bun": "1.3.1"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "hyper": "./src/bin.ts"
  }
}
